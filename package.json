    "date-fns": "^4.1.0",
    "dompurify": "^3.4.11",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "isomorphic-git": "^1.38.5",
    "lucide-react": "^0.562.0",
    "npm-run-all": "^4.1.5",
    "puter": "^1.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-rnd": "^10.5.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.14.0",
